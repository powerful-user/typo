{
  "name": "@typo-cli/typo",
  "version": "0.1.0",
  "description": "Font management CLI for web and mobile projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
